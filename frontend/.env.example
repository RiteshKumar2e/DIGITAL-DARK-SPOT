# Public build-time settings only. Everything here ends up in the browser bundle,
# so never put API keys or secrets in this file.

# Base URL of the backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:4000

# Public URL where the frontend is deployed, e.g. https://dds.example.org
# Used for canonical links, Open Graph URLs and sitemap.xml. Leave empty until known.
VITE_SITE_URL=
