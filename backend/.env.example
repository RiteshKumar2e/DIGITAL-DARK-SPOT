# Copy to .env and adjust. Never commit the real .env file.

# Port the API listens on
PORT=4000

# Comma-separated list of browser origins allowed to call the API (your frontend URL)
FRONTEND_ORIGIN=http://localhost:5173

# Set to "production" when deployed
NODE_ENV=development

# Number of reverse proxies in front of the API (e.g. 1 on Render/Railway/Heroku).
# Needed so rate limiting sees the real client IP. Leave 0 for local development.
TRUST_PROXY=0

# Research sessions older than this many days are deleted automatically
SESSION_RETENTION_DAYS=30

# Optional: enables the AI-assisted review layer (Groq).
# Without it, the deterministic rule-based analysis still runs.
GROQ_API_KEY=
# Optional model override (any Groq chat model that supports JSON mode)
GROQ_MODEL=openai/gpt-oss-120b
# Request size per review. Defaults fit Groq's free tier (8,000 tokens/minute).
GROQ_MAX_INPUT_CHARS=14000
GROQ_MAX_OUTPUT_TOKENS=2500

# Optional: web search for source discovery. Pick one provider and set its key.
# Both have free tiers: Tavily (https://tavily.com) and Serper (https://serper.dev).
# Without a key, users add sources manually (URLs, pasted text, PDF upload).
SEARCH_PROVIDER=
TAVILY_API_KEY=
SERPER_API_KEY=

# Maximum PDF upload / download size in megabytes
MAX_PDF_MB=10
